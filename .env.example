# Copy to apps/api/.env (API) and apps/web/.env.local (web). Never commit real values.
# See docs/10-ENVIRONMENT-VARIABLES.md.

# --- API (apps/api/.env) ---
NODE_ENV=development
API_PORT=4000
# Browser origin(s) allowed by CORS and CSRF origin checks, comma separated.
WEB_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://dpms:dpms_local_dev_only@localhost:5432/dpms?schema=public
LOG_LEVEL=info
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
# Must be true in staging/production (Secure cookies). false only for plain-http localhost.
COOKIE_SECURE=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SWAGGER_ENABLED=true

# Imaging object storage — optional. Leave ALL unset to disable imaging (uploads return 503).
# Use a PRIVATE bucket with provider-side encryption. Never commit real keys.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_FORCE_PATH_STYLE=true
# IMAGING_MAX_BYTES=25000000

# --- Web (apps/web/.env.local) ---
# Server-side URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:4000

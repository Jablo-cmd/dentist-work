{
  "name": "noordwyk-dpms",
  "version": "0.1.0",
  "private": true,
  "description": "Noordwyk Dental Practice Management System (Auris Nexus Technologies)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @dpms/contracts build && pnpm --filter @dpms/api build && pnpm --filter @dpms/web build",
    "dev:api": "pnpm --filter @dpms/contracts build && pnpm --filter @dpms/api dev",
    "dev:web": "pnpm --filter @dpms/contracts build && pnpm --filter @dpms/web dev",
    "typecheck": "pnpm --filter @dpms/contracts build && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @dpms/contracts build && pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @dpms/e2e test",
    "test:integration": "pnpm --filter @dpms/contracts build && pnpm --filter @dpms/api test:integration",
    "db:migrate": "pnpm --filter @dpms/api db:migrate",
    "db:migrate:dev": "pnpm --filter @dpms/api db:migrate:dev",
    "db:validate": "pnpm --filter @dpms/api db:validate",
    "audit:deps": "pnpm audit --prod --audit-level high"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0"
  }
}

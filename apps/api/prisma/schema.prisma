// Noordwyk DPMS — database schema.
//
// Responsibilities (grouped in this file, in migration order):
//   1. Organisation / practice structure, users, role assignments, sessions, append-only audit events.
//   2. Patients: demographics, practice links (visibility), contacts, revisions, medical history,
//      allergies, duplicate-review flags.
//   3. Appointments and their append-only event history (no double-booking via exclusion constraints).
//   4. Clinical records: encounters, immutable note versions, dental chart (FDI), treatment plans.
//   5. Imaging metadata (binaries live in private object storage, never in PostgreSQL).
//   6. Billing: invoices, lines, payments, allocations, gap-free numbering (NUMERIC(12,2) money).
//   7. Multi-factor authentication: encrypted TOTP secrets, recovery-code hashes, login challenges.
//
// Not modelled: vendor integration data (VistaSoft / 3Shape TRIOS), patient-record merging, reminders.
//
// Conventions (details: docs/12-DATABASE-AND-MIGRATIONS.md):
//  - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
//  - All timestamps are timestamptz (stored in UTC); display conversion is a UI concern.
//  - Business records are deactivated, never hard-deleted (isActive / revokedAt / resolvedAt).
//  - Much of the integrity (immutability, append-only history, over-allocation and double-booking
//    guards) is enforced by hand-written SQL in the migrations (triggers, CHECKs, exclusion
//    constraints) that Prisma cannot express; do not edit applied migrations.
//  - Tables hold special personal information (POPIA): never log column values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  ORGANISATION_OWNER
  PRACTICE_ADMINISTRATOR
  DENTIST
  RECEPTIONIST
  BILLING_ADMINISTRATOR
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model Organisation {
  invoices       Invoice[]
  payments       Payment[]
  imagingAssets  ImagingAsset[]
  encounters     ClinicalEncounter[]
  treatmentPlans TreatmentPlan[]
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  practices    Practice[]
  users        User[]
  appointments Appointment[]

  @@map("organisations")
}

model Practice {
  invoices       Invoice[]
  payments       Payment[]
  imagingAssets  ImagingAsset[]
  encounters     ClinicalEncounter[]
  treatmentPlans TreatmentPlan[]
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String              @db.Uuid
  name           String
  /// Short stable code, upper-case letters/digits/hyphen (enforced by CHECK constraint).
  code           String
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  roleAssignments UserRoleAssignment[]
  patientLinks    PatientPractice[]
  appointments    Appointment[]

  @@unique([organisationId, code])
  @@unique([organisationId, name])
  @@map("practices")
}

model User {
  mfa                      UserMfa?
  mfaRecoveryCodes         MfaRecoveryCode[]
  mfaChallenges            MfaChallenge[]
  encountersAsPractitioner ClinicalEncounter[]   @relation("EncounterPractitioner")
  noteVersions             ClinicalNoteVersion[] @relation("NoteAuthor")
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId           String                @db.Uuid
  /// Stored lower-case (CHECK constraint). Login identifier.
  email                    String                @unique
  displayName              String
  /// Argon2id PHC string. Never returned by any API.
  passwordHash             String
  isActive                 Boolean               @default(true)
  mustChangePassword       Boolean               @default(false)
  passwordChangedAt        DateTime?             @db.Timestamptz(6)
  failedLoginCount         Int                   @default(0)
  lockedUntil              DateTime?             @db.Timestamptz(6)
  lastLoginAt              DateTime?             @db.Timestamptz(6)
  createdAt                DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(6)

  organisation             Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  roleAssignments          UserRoleAssignment[]
  sessions                 Session[]
  auditEvents              AuditEvent[]
  practitionerAppointments Appointment[]        @relation("AppointmentPractitioner")
  appointmentEvents        AppointmentEvent[]   @relation("AppointmentEventActor")

  @@index([organisationId])
  @@map("users")
}

/// Grants a role to a user. practiceId NULL = organisation-wide; otherwise scoped to that practice.
/// Uniqueness for the NULL case is enforced by a partial unique index in the migration SQL.
model UserRoleAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  role       RoleKey
  practiceId String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice? @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  @@unique([userId, role, practiceId])
  @@index([practiceId])
  @@map("user_role_assignments")
}

/// Server-side session. Only a SHA-256 hash of the random bearer token is stored.
model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only audit trail (UPDATE/DELETE blocked by database trigger).
/// metadata MUST NOT contain clinical content, credentials, tokens or free-text patient data.
model AuditEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(6)
  actorUserId    String?      @db.Uuid
  organisationId String?      @db.Uuid
  practiceId     String?      @db.Uuid
  /// Dotted action name, e.g. auth.login, access.denied.
  action         String
  targetType     String?
  targetId       String?
  outcome        AuditOutcome
  requestId      String?
  ipAddress      String?
  metadata       Json         @default("{}")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([organisationId, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 2 — patient administration. Contains special personal information (POPIA).
// Never log column values from these tables.
// ---------------------------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum HistoryCategory {
  CONDITION
  MEDICATION
  SURGERY
  FAMILY
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum DuplicateStatus {
  PENDING
  DISTINCT_PATIENTS
  CONFIRMED_DUPLICATE
}

model Patient {
  invoices              Invoice[]
  payments              Payment[]
  imagingAssets         ImagingAsset[]
  encounters            ClinicalEncounter[]
  chartEntries          DentalChartEntry[]
  treatmentPlans        TreatmentPlan[]
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String              @db.Uuid
  registeringPracticeId String              @db.Uuid
  firstName             String
  lastName              String
  preferredName         String?
  dateOfBirth           DateTime            @db.Date
  sex                   Sex                 @default(UNSPECIFIED)
  /// National ID or passport number. Not unique: mistakes and shared documents are handled by duplicate review.
  idNumber              String?
  email                 String?
  /// Normalised (+27…) for matching.
  mobilePhone           String?
  homePhone             String?
  addressLine1          String?
  addressLine2          String?
  suburb                String?
  city                  String?
  postalCode            String?
  isActive              Boolean             @default(true)
  createdByUserId       String?             @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)

  practices      PatientPractice[]
  appointments   Appointment[]
  contacts       PatientContact[]
  revisions      PatientRevision[]
  historyEntries MedicalHistoryEntry[]
  allergies      Allergy[]
  flagsAsA       PatientDuplicateFlag[] @relation("FlagA")
  flagsAsB       PatientDuplicateFlag[] @relation("FlagB")

  @@index([organisationId, lastName, firstName])
  @@index([organisationId, dateOfBirth])
  @@index([organisationId, mobilePhone])
  @@index([organisationId, idNumber])
  @@map("patients")
}

/// A patient is visible only in practices they are linked to. Linking another practice is an explicit act.
model PatientPractice {
  patientId      String   @db.Uuid
  practiceId     String   @db.Uuid
  linkedAt       DateTime @default(now()) @db.Timestamptz(6)
  linkedByUserId String?  @db.Uuid

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  @@id([patientId, practiceId])
  @@index([practiceId])
  @@map("patient_practices")
}

model PatientContact {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId          String   @db.Uuid
  name               String
  relationship       String
  phone              String
  isEmergencyContact Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_contacts")
}

/// Who changed which fields and when. Field names only; prior values are not duplicated here.
model PatientRevision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String   @db.Uuid
  changedByUserId String?  @db.Uuid
  changedAt       DateTime @default(now()) @db.Timestamptz(6)
  fields          String[]

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, changedAt])
  @@map("patient_revisions")
}

/// Append-only clinical history. Corrections: resolve the entry and add a new one.
model MedicalHistoryEntry {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String          @db.Uuid
  category         HistoryCategory
  description      String
  source           String
  recordedOn       DateTime        @db.Date
  isAlert          Boolean         @default(false)
  createdByUserId  String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime?       @db.Timestamptz(6)
  resolvedByUserId String?         @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@map("medical_history_entries")
}

model Allergy {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String          @db.Uuid
  substance        String
  reaction         String?
  severity         AllergySeverity
  source           String
  recordedOn       DateTime        @db.Date
  createdByUserId  String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime?       @db.Timestamptz(6)
  resolvedByUserId String?         @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@map("allergies")
}

/// Possible duplicate pair awaiting human review. patientAId < patientBId (CHECK) so a pair exists once.
model PatientDuplicateFlag {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientAId       String          @db.Uuid
  patientBId       String          @db.Uuid
  reasons          String[]
  status           DuplicateStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  reviewedByUserId String?         @db.Uuid
  reviewedAt       DateTime?       @db.Timestamptz(6)

  patientA Patient @relation("FlagA", fields: [patientAId], references: [id], onDelete: Restrict)
  patientB Patient @relation("FlagB", fields: [patientBId], references: [id], onDelete: Restrict)

  @@unique([patientAId, patientBId])
  @@index([status])
  @@map("patient_duplicate_flags")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 — appointments
// ---------------------------------------------------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  CHECKED_IN
  COMPLETED
  NO_SHOW
}

/// Overlap for the same practitioner or the same patient is rejected by exclusion constraints
/// (see migration SQL), so concurrent requests cannot double-book.
model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String            @db.Uuid
  practiceId         String            @db.Uuid
  patientId          String            @db.Uuid
  practitionerUserId String            @db.Uuid
  startsAt           DateTime          @db.Timestamptz(6)
  endsAt             DateTime          @db.Timestamptz(6)
  status             AppointmentStatus @default(SCHEDULED)
  /// Administrative reason only (e.g. "Check-up"); clinical detail belongs in the clinical record.
  reason             String?
  cancelReason       String?
  createdByUserId    String?           @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "appointments_organisation_fk")
  practice     Practice           @relation(fields: [practiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "appointments_practice_fk")
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "appointments_patient_fk")
  practitioner User               @relation("AppointmentPractitioner", fields: [practitionerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "appointments_practitioner_fk")
  events       AppointmentEvent[]

  @@index([practiceId, startsAt])
  @@index([practitionerUserId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

model AppointmentEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String               @db.Uuid
  type          AppointmentEventType
  actorUserId   String?              @db.Uuid
  occurredAt    DateTime             @default(now()) @db.Timestamptz(6)
  fromStartsAt  DateTime?            @db.Timestamptz(6)
  fromEndsAt    DateTime?            @db.Timestamptz(6)
  toStartsAt    DateTime?            @db.Timestamptz(6)
  toEndsAt      DateTime?            @db.Timestamptz(6)
  reason        String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actor       User?       @relation("AppointmentEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "appointment_events_actor_fk")

  @@index([appointmentId, occurredAt])
  @@map("appointment_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 4 — clinical records (special personal information; never log values)
// ---------------------------------------------------------------------------------------------

enum EncounterStatus {
  DRAFT
  FINALISED
}

enum NoteKind {
  DRAFT
  AMENDMENT
  ADDENDUM
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  INCISAL
  BUCCAL_LABIAL
  LINGUAL_PALATAL
}

enum ToothCondition {
  CARIES
  FILLING
  CROWN
  BRIDGE_PONTIC
  IMPLANT
  ROOT_CANAL_TREATED
  FRACTURE
  MISSING
  IMPACTED
  EROSION_WEAR
  PERIODONTAL_CONCERN
  OTHER
}

enum TreatmentItemStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  DEFERRED
  COMPLETED
}

model ClinicalEncounter {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId     String          @db.Uuid
  practiceId         String          @db.Uuid
  patientId          String          @db.Uuid
  practitionerUserId String          @db.Uuid
  appointmentId      String?         @db.Uuid
  encounteredAt      DateTime        @default(now()) @db.Timestamptz(6)
  status             EncounterStatus @default(DRAFT)
  finalisedAt        DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  practice     Practice              @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  practitioner User                  @relation("EncounterPractitioner", fields: [practitionerUserId], references: [id], onDelete: Restrict)
  notes        ClinicalNoteVersion[]

  @@index([patientId, encounteredAt])
  @@index([practiceId, encounteredAt])
  @@map("clinical_encounters")
}

/// Immutable (DB trigger). Every draft save, amendment and addendum is a new row.
model ClinicalNoteVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId   String   @db.Uuid
  versionNumber Int
  kind          NoteKind
  body          String
  reason        String?
  amendsVersion Int?
  authorUserId  String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author    User              @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([encounterId, versionNumber])
  @@map("clinical_note_versions")
}

/// FDI tooth numbering (working default; client confirmation pending). Resolve-and-re-enter, never edit.
model DentalChartEntry {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String         @db.Uuid
  encounterId      String?        @db.Uuid
  toothNumber      String
  surfaces         ToothSurface[]
  condition        ToothCondition
  note             String?
  recordedByUserId String         @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime?      @db.Timestamptz(6)
  resolvedByUserId String?        @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, toothNumber])
  @@map("dental_chart_entries")
}

model TreatmentPlan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId  String   @db.Uuid
  practiceId      String   @db.Uuid
  patientId       String   @db.Uuid
  title           String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  practice     Practice            @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items        TreatmentPlanItem[]

  @@index([patientId, createdAt])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String              @db.Uuid
  toothNumber     String?
  description     String
  estimatedAmount Decimal?            @db.Decimal(12, 2)
  status          TreatmentItemStatus @default(PROPOSED)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  plan   TreatmentPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  events TreatmentPlanItemEvent[]

  @@index([planId])
  @@map("treatment_plan_items")
}

model TreatmentPlanItemEvent {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String               @db.Uuid
  fromStatus  TreatmentItemStatus?
  toStatus    TreatmentItemStatus
  actorUserId String?              @db.Uuid
  occurredAt  DateTime             @default(now()) @db.Timestamptz(6)
  note        String?

  item TreatmentPlanItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, occurredAt])
  @@map("treatment_plan_item_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 5 — imaging metadata. Binary files live in private object storage, never in PostgreSQL.
// ---------------------------------------------------------------------------------------------

enum ImagingModality {
  XRAY_INTRAORAL
  XRAY_PANORAMIC
  XRAY_CEPHALOMETRIC
  PHOTO
  DOCUMENT
  SCAN_3D
  OTHER
}

/// Malware-scan lifecycle. Only CLEAN files can ever be viewed or downloaded (fail closed).
///  PENDING     stored but not yet scanned (also: scanner not configured / unreachable)
///  SCAN_FAILED the scanner errored or timed out on the last attempt; retried automatically
///  CLEAN       passed; final
///  INFECTED    malware found; final; stored bytes are deleted, the record and hash are kept
enum ScanStatus {
  PENDING
  SCAN_FAILED
  CLEAN
  INFECTED
}

/// Immutable metadata (DB trigger). Retention/deletion rules are an open client decision (Q20),
/// so assets cannot be deleted through the application.
model ImagingAsset {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String          @db.Uuid
  practiceId       String          @db.Uuid
  patientId        String          @db.Uuid
  encounterId      String?         @db.Uuid
  modality         ImagingModality
  mimeType         String
  originalFilename String
  sizeBytes        Int
  sha256           String
  /// Opaque key (imaging/<org>/<uuid>); contains no patient information.
  objectKey        String          @unique
  source           String          @default("manual_upload")
  scanStatus       ScanStatus      @default(PENDING)
  scannedAt        DateTime?       @db.Timestamptz(6)
  /// Engine identifier and version reported by the scanner (e.g. "ClamAV 1.4.1").
  scanEngine       String?
  /// Failed or incomplete attempts so far; retries stop at the configured maximum.
  scanAttempts     Int             @default(0)
  acquiredAt       DateTime?       @db.Timestamptz(6)
  uploadedByUserId String          @db.Uuid
  uploadedAt       DateTime        @default(now()) @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  practice     Practice     @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([patientId, sha256])
  @@index([patientId, uploadedAt])
  @@map("imaging_assets")
}

// ---------------------------------------------------------------------------------------------
// Phase 7 — billing. All money is NUMERIC(12,2) (Prisma Decimal); never floating point.
// Posted records are immutable (DB triggers); corrections use credit notes / payment reversals.
// ---------------------------------------------------------------------------------------------

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

/// Gap-free numbering per organisation and kind; the number is taken inside the posting transaction.
model InvoiceSequence {
  organisationId String      @db.Uuid
  kind           InvoiceKind
  nextValue      Int         @default(1)

  @@id([organisationId, kind])
  @@map("invoice_sequences")
}

model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String        @db.Uuid
  practiceId       String        @db.Uuid
  patientId        String        @db.Uuid
  kind             InvoiceKind   @default(INVOICE)
  status           InvoiceStatus @default(DRAFT)
  /// Assigned at posting. INV-000001 / CN-000001 (format pending accountant confirmation, Q12).
  number           String?
  issueDate        DateTime?     @db.Date
  currency         String        @default("ZAR")
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @default(0) @db.Decimal(12, 2)
  /// Credit notes only: the invoice being credited.
  creditsInvoiceId String?       @db.Uuid
  reason           String?
  createdByUserId  String        @db.Uuid
  postedByUserId   String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  postedAt         DateTime?     @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  practice     Practice            @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  credits      Invoice?            @relation("CreditNotes", fields: [creditsInvoiceId], references: [id], onDelete: Restrict)
  creditNotes  Invoice[]           @relation("CreditNotes")
  lines        InvoiceLine[]
  allocations  PaymentAllocation[]

  @@unique([organisationId, number])
  @@index([patientId, createdAt])
  @@index([practiceId, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String  @db.Uuid
  lineNo          Int
  description     String
  quantity        Decimal @db.Decimal(8, 2)
  unitPrice       Decimal @db.Decimal(12, 2)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)
  /// round(quantity * unitPrice, 2) + taxAmount
  lineTotal       Decimal @db.Decimal(12, 2)
  treatmentItemId String? @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String        @db.Uuid
  practiceId       String        @db.Uuid
  patientId        String        @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  reference        String?
  receivedOn       DateTime      @db.Date
  status           PaymentStatus @default(RECORDED)
  /// Client-supplied retry key: the same key can never create a second payment.
  idempotencyKey   String
  /// SHA-256 of the canonical request, to detect key reuse with a different body.
  requestHash      String
  createdByUserId  String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  reversedAt       DateTime?     @db.Timestamptz(6)
  reversedByUserId String?       @db.Uuid
  reversalReason   String?

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  practice     Practice            @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@unique([organisationId, idempotencyKey])
  @@index([patientId, createdAt])
  @@index([practiceId, receivedOn])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String   @db.Uuid
  invoiceId String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------------------------
// Multi-factor authentication (TOTP). Secrets are AES-256-GCM encrypted with MFA_ENCRYPTION_KEY.
// ---------------------------------------------------------------------------------------------

model UserMfa {
  userId       String    @id @db.Uuid
  /// base64(iv | tag | ciphertext) of the raw TOTP secret.
  secretEnc    String
  /// NULL until the user proves possession of the secret by entering a valid code.
  confirmedAt  DateTime? @db.Timestamptz(6)
  /// Last accepted time step; codes at or below it are rejected (replay protection).
  lastUsedStep BigInt?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model MfaRecoveryCode {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String    @db.Uuid
  /// SHA-256 of the code (80-bit random, so a fast hash is sufficient).
  codeHash String
  usedAt   DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// Single-use, short-lived proof that the password step succeeded. Only a hash of the token is stored.
model MfaChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

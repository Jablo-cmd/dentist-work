// Noordwyk DPMS — foundation schema.
// Scope: organisation/practice structure, users, role assignments, sessions, audit.
// Clinical, patient, imaging and billing entities are deliberately NOT modelled yet
// (docs/08 roadmap phases 2+). Conventions: see docs/12-DATABASE-AND-MIGRATIONS.md.
//  - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
//  - All timestamps are timestamptz (stored in UTC); display conversion is a UI concern.
//  - Business records are deactivated, never hard-deleted (isActive / revokedAt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  ORGANISATION_OWNER
  PRACTICE_ADMINISTRATOR
  DENTIST
  RECEPTIONIST
  BILLING_ADMINISTRATOR
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model Organisation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  practices Practice[]
  users     User[]

  @@map("organisations")
}

model Practice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @db.Uuid
  name           String
  /// Short stable code, upper-case letters/digits/hyphen (enforced by CHECK constraint).
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  roleAssignments UserRoleAssignment[]

  @@unique([organisationId, code])
  @@unique([organisationId, name])
  @@map("practices")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String    @db.Uuid
  /// Stored lower-case (CHECK constraint). Login identifier.
  email          String    @unique
  displayName    String
  /// Argon2id PHC string. Never returned by any API.
  passwordHash   String
  isActive       Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  passwordChangedAt DateTime? @db.Timestamptz(6)
  failedLoginCount Int     @default(0)
  lockedUntil    DateTime? @db.Timestamptz(6)
  lastLoginAt    DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  roleAssignments UserRoleAssignment[]
  sessions        Session[]
  auditEvents     AuditEvent[]

  @@index([organisationId])
  @@map("users")
}

/// Grants a role to a user. practiceId NULL = organisation-wide; otherwise scoped to that practice.
/// Uniqueness for the NULL case is enforced by a partial unique index in the migration SQL.
model UserRoleAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  role       RoleKey
  practiceId String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice? @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  @@unique([userId, role, practiceId])
  @@index([practiceId])
  @@map("user_role_assignments")
}

/// Server-side session. Only a SHA-256 hash of the random bearer token is stored.
model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only audit trail (UPDATE/DELETE blocked by database trigger).
/// metadata MUST NOT contain clinical content, credentials, tokens or free-text patient data.
model AuditEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(6)
  actorUserId    String?      @db.Uuid
  organisationId String?      @db.Uuid
  practiceId     String?      @db.Uuid
  /// Dotted action name, e.g. auth.login, access.denied.
  action         String
  targetType     String?
  targetId       String?
  outcome        AuditOutcome
  requestId      String?
  ipAddress      String?
  metadata       Json         @default("{}")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([organisationId, occurredAt])
  @@map("audit_events")
}
